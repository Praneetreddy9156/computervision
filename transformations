
import os
import cv2
import numpy as np
import matplotlib.pyplot as plt
from PIL import Image
from tkinter import Tk, filedialog


# ============================================================
# IMAGE UPLOAD / SELECTION
# ============================================================

def upload_image():
    root = Tk()
    root.withdraw()
    root.attributes("-topmost", True)

    try:
        image_path = filedialog.askopenfilename(
            title="Select an Image",
            filetypes=[
                ("Image files", "*.jpg *.jpeg *.png *.bmp *.webp"),
                ("All files", "*.*")
            ]
        )
    finally:
        root.destroy()

    if not image_path:
        print("No image selected.")
        return None

    if cv2.imread(image_path) is None:
        print("Invalid image file.")
        return None

    print("Image selected:", image_path)
    return image_path


# ============================================================
# DISPLAY IMAGE
# ============================================================

def display_image(image, title, is_cv=False):
    if is_cv:
        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

    plt.figure(figsize=(8, 6))
    plt.imshow(image)
    plt.title(title)
    plt.axis("off")
    plt.tight_layout()
    plt.show()


# ============================================================
# CLASS 1: GEOMETRIC TRANSFORMATIONS
# ============================================================

class GeometricTransformer:

    def __init__(self, image_path):
        self.image_path = image_path
        self.img_pil = Image.open(image_path).convert("RGB")
        self.img_cv = cv2.imread(image_path)

        if self.img_cv is None:
            raise ValueError("Unable to read image.")

    # 1. TRANSLATION
    def translate(self, tx=50, ty=30):
        tx, ty = int(tx), int(ty)
        width, height = self.img_pil.size

        # PIL translation
        translated_pil = Image.new(
            "RGB", (width, height), (255, 255, 255)
        )
        translated_pil.paste(self.img_pil, (tx, ty))

        # OpenCV translation
        rows, cols = self.img_cv.shape[:2]
        matrix = np.float32([
            [1, 0, tx],
            [0, 1, ty]
        ])

        translated_cv = cv2.warpAffine(
            self.img_cv, matrix, (cols, rows),
            borderValue=(255, 255, 255)
        )

        return translated_pil, translated_cv

    # 2. ROTATION
    def rotate(self, angle=45):
        rotated_pil = self.img_pil.rotate(
            angle, expand=True,
            fillcolor=(255, 255, 255)
        )

        rows, cols = self.img_cv.shape[:2]
        center = (cols / 2, rows / 2)

        matrix = cv2.getRotationMatrix2D(center, angle, 1.0)

        cos_a = abs(matrix[0, 0])
        sin_a = abs(matrix[0, 1])

        new_width = int(rows * sin_a + cols * cos_a)
        new_height = int(rows * cos_a + cols * sin_a)

        matrix[0, 2] += new_width / 2 - center[0]
        matrix[1, 2] += new_height / 2 - center[1]

        rotated_cv = cv2.warpAffine(
            self.img_cv, matrix, (new_width, new_height),
            borderValue=(255, 255, 255)
        )

        return rotated_pil, rotated_cv

    # 3. SCALING
    def scale(self, scale_x=1.5, scale_y=0.8):
        if scale_x <= 0 or scale_y <= 0:
            raise ValueError("Scale factors must be positive.")

        width, height = self.img_pil.size

        scaled_pil = self.img_pil.resize(
            (
                max(1, int(width * scale_x)),
                max(1, int(height * scale_y))
            ),
            Image.Resampling.LANCZOS
        )

        rows, cols = self.img_cv.shape[:2]

        scaled_cv = cv2.resize(
            self.img_cv,
            (
                max(1, int(cols * scale_x)),
                max(1, int(rows * scale_y))
            ),
            interpolation=cv2.INTER_LANCZOS4
        )

        return scaled_pil, scaled_cv

    # 4. SHEARING
    def shear(self, shear_x=0.3, shear_y=0.2):
        width, height = self.img_pil.size

        corners = np.float32([
            [0, 0],
            [width, 0],
            [0, height],
            [width, height]
        ])

        matrix = np.float32([
            [1, shear_x, 0],
            [shear_y, 1, 0]
        ])

        transformed = corners @ matrix[:, :2].T

        min_x, min_y = transformed.min(axis=0)
        max_x, max_y = transformed.max(axis=0)

        new_width = max(1, int(np.ceil(max_x - min_x)))
        new_height = max(1, int(np.ceil(max_y - min_y)))

        matrix[0, 2] = -min_x
        matrix[1, 2] = -min_y

        sheared = cv2.warpAffine(
            np.array(self.img_pil),
            matrix,
            (new_width, new_height),
            borderValue=(255, 255, 255)
        )

        return Image.fromarray(sheared)

    # MENU
    def interactive_menu(self):
        while True:
            print("\n===== GEOMETRIC TRANSFORMATIONS =====")
            print("1. Translation")
            print("2. Rotation")
            print("3. Scaling")
            print("4. Shearing")
            print("0. Exit")

            try:
                choice = int(input("Enter choice: "))

                if choice == 0:
                    print("Exiting Geometric menu.")
                    break

                if choice == 1:
                    tx = float(input("Enter translation X: "))
                    ty = float(input("Enter translation Y: "))
                    result, _ = self.translate(tx, ty)
                    display_image(result, "Translation")

                elif choice == 2:
                    angle = float(input("Enter rotation angle: "))
                    result, _ = self.rotate(angle)
                    display_image(result, "Rotation")

                elif choice == 3:
                    sx = float(input("Enter scale X: "))
                    sy = float(input("Enter scale Y: "))
                    result, _ = self.scale(sx, sy)
                    display_image(result, "Scaling")

                elif choice == 4:
                    shx = float(input("Enter shear X: "))
                    shy = float(input("Enter shear Y: "))
                    result = self.shear(shx, shy)
                    display_image(result, "Shearing")

                else:
                    print("Invalid choice. Select 0-4.")

            except (ValueError, OverflowError) as error:
                print("Invalid input:", error)


# ============================================================
# CLASS 2: AFFINE TRANSFORMATIONS
# ============================================================

class FlexibleAffine:

    def __init__(self, image_path):
        self.image_path = image_path
        self.img = None
        self.rows = None
        self.cols = None
        self.matrix = np.eye(3, dtype=np.float64)

    # READ IMAGE
    def read_image(self):
        self.img = cv2.imread(self.image_path)

        if self.img is None:
            raise ValueError("Unable to read image.")

        self.rows, self.cols = self.img.shape[:2]

    # ROTATION
    def add_rotation(self, angle):
        center = (self.cols / 2, self.rows / 2)

        rotation = cv2.getRotationMatrix2D(
            center, angle, 1.0
        )

        rotation = np.vstack([rotation, [0, 0, 1]])
        self.matrix = rotation @ self.matrix

    # SCALING
    def add_scaling(self, sx, sy):
        if sx <= 0 or sy <= 0:
            raise ValueError("Scale factors must be positive.")

        scale = np.array([
            [sx, 0, 0],
            [0, sy, 0],
            [0, 0, 1]
        ], dtype=np.float64)

        self.matrix = scale @ self.matrix

    # SHEARING
    def add_shearing(self, shx, shy):
        shear = np.array([
            [1, shx, 0],
            [shy, 1, 0],
            [0, 0, 1]
        ], dtype=np.float64)

        self.matrix = shear @ self.matrix

    # TRANSLATION
    def add_translation(self, tx, ty):
        translation = np.array([
            [1, 0, tx],
            [0, 1, ty],
            [0, 0, 1]
        ], dtype=np.float64)

        self.matrix = translation @ self.matrix

    # APPLY COMBINED TRANSFORMATION
    def apply(self):
        corners = np.array([
            [0, 0, 1],
            [self.cols, 0, 1],
            [0, self.rows, 1],
            [self.cols, self.rows, 1]
        ], dtype=np.float64)

        transformed = corners @ self.matrix.T

        min_x, min_y = transformed[:, :2].min(axis=0)
        max_x, max_y = transformed[:, :2].max(axis=0)

        new_width = max(1, int(np.ceil(max_x - min_x)))
        new_height = max(1, int(np.ceil(max_y - min_y)))

        matrix = self.matrix[:2, :].copy()
        matrix[0, 2] -= min_x
        matrix[1, 2] -= min_y

        return cv2.warpAffine(
            self.img, matrix,
            (new_width, new_height),
            borderValue=(255, 255, 255)
        )

    # DISPLAY
    def display(self, result):
        display_image(result, "Affine Transformation", is_cv=True)

    # MENU
    def user_menu(self):
        while True:
            print("\n===== AFFINE TRANSFORMATIONS =====")
            print("1. Rotation")
            print("2. Scaling")
            print("3. Shearing")
            print("4. Translation")
            print("5. Apply All (default values)")
            print("6. Reset transformations")
            print("0. Exit")

            try:
                raw = input(
                    "Enter choices separated by commas: "
                ).strip()

                choices = [
                    int(item.strip())
                    for item in raw.split(",")
                ]

                if not choices or any(
                    choice not in range(0, 7)
                    for choice in choices
                ):
                    print("Choose valid options from 0-6.")
                    continue

                if 0 in choices:
                    print("Exiting Affine menu.")
                    break

                if 6 in choices:
                    self.matrix = np.eye(3, dtype=np.float64)
                    print("Transformations reset.")
                    continue

                for choice in choices:
                    if choice == 1:
                        angle = float(
                            input("Enter rotation angle: ")
                        )
                        self.add_rotation(angle)

                    elif choice == 2:
                        sx = float(input("Enter scale X: "))
                        sy = float(input("Enter scale Y: "))
                        self.add_scaling(sx, sy)

                    elif choice == 3:
                        shx = float(input("Enter shear X: "))
                        shy = float(input("Enter shear Y: "))
                        self.add_shearing(shx, shy)

                    elif choice == 4:
                        tx = float(input("Enter translation X: "))
                        ty = float(input("Enter translation Y: "))
                        self.add_translation(tx, ty)

                    elif choice == 5:
                        self.add_rotation(30)
                        self.add_scaling(1.2, 1.2)
                        self.add_shearing(0.2, 0)
                        self.add_translation(50, 30)

                result = self.apply()
                self.display(result)

            except (ValueError, OverflowError) as error:
                print("Invalid input:", error)


# ============================================================
# MAIN PROGRAM
# ============================================================

def main():
    print("===== IMAGE TRANSFORMATION PROGRAM =====")

    image_path = upload_image()

    if image_path is None:
        return

    try:
        print("\n1. Affine Transformations")
        print("2. Geometric Transformations")

        choice = int(input("Choose 1 or 2: "))

        if choice == 1:
            obj = FlexibleAffine(image_path)
            obj.read_image()
            obj.user_menu()

        elif choice == 2:
            obj = GeometricTransformer(image_path)
            obj.interactive_menu()

        else:
            print("Invalid choice. Select 1 or 2.")

    except (ValueError, OSError, cv2.error) as error:
        print("Error:", error)


if __name__ == "__main__":
    main()
